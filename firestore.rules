rules_version = '2';
// Cada persona solo puede leer y escribir sus propios datos.
// Excepción: «isPro», los datos de Stripe, «ultimoEscaneo» (límite diario de la IA gratis) y el aviso «strava» solo los cambia el servidor (stripeWebhook y strava),
// para que nadie pueda hacerse Pro ni falsear la conexión desde la app. Los tokens de Strava viven en la colección
// «stravaTokens», sin ninguna regla: la app no puede leerla ni escribirla (solo el servidor).
service cloud.firestore {
  match /databases/{database}/documents {
    // Sugerencias de funciones: cada persona puede enviar las suyas, pero nadie las lee desde la app (se ven en la consola de Firebase).
    match /feature_requests/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 1000;
    }
    // Rutinas compartidas por código: el id del documento es el código. Cualquiera con sesión puede leer UNA si sabe el código
    // (get), pero no listarlas; solo su autor la crea, actualiza o borra.
    match /shared_routines/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && code.size() == 6;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.get('isPro', false) == false
        && !('stripeCustomerId' in request.resource.data)
        && !('stripeSubscriptionId' in request.resource.data)
        && !('strava' in request.resource.data)
        && !('ultimoEscaneo' in request.resource.data)
        && request.resource.data.get('proPlan', 'none') == 'none'; // al crear, `proPlan` solo puede faltar o valer 'none'; los planes de pago los pone el servidor
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.get('isPro', false) == resource.data.get('isPro', false)
        && request.resource.data.get('stripeCustomerId', null) == resource.data.get('stripeCustomerId', null)
        && request.resource.data.get('stripeSubscriptionId', null) == resource.data.get('stripeSubscriptionId', null)
        && request.resource.data.get('strava', null) == resource.data.get('strava', null)
        && request.resource.data.get('ultimoEscaneo', null) == resource.data.get('ultimoEscaneo', null)
        && request.resource.data.get('proPlan', null) == resource.data.get('proPlan', null)
        // Límite gratuito: sin Pro, rutinas y ejercicios propios no pueden pasar de 3 (quien ya tenga más puede mantenerlos o borrar, no añadir).
        && (resource.data.get('isPro', false) == true
          || ((request.resource.data.get('rutinas', []).size() <= 3 || request.resource.data.get('rutinas', []).size() <= resource.data.get('rutinas', []).size())
            && (request.resource.data.get('ejPropios', []).size() <= 3 || request.resource.data.get('ejPropios', []).size() <= resource.data.get('ejPropios', []).size())));
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
