rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────
// Reglas de Firestore de Cadencia (endurecidas para producción, 2026-11-22).
//
//  1. NADA es público: todo exige sesión (request.auth != null) y lo que no esté escrito aquí queda denegado (regla final).
//  2. Cada persona solo lee y escribe SUS documentos: users/{uid} y sus subcolecciones (pesos, entrenos, comidas —incluye hidratación—, rutas).
//  3. Campos SOLO-SERVIDOR (nadie los cambia desde el navegador, ni siquiera con la consola): isPro, proPlan, proCaduca, proRenueva, proCancela,
//     proActualizado, stripeCustomerId, stripeSubscriptionId, strava, ultimoEscaneo, refCode, referidos, recompensas, codigoUsado.
//     Los escriben las Cloud Functions (stripeWebhook, strava, ia, miCodigo, canjearCodigo, reclamarReferido, caducarPro) con permisos de servidor.
//     Se comprueba con diff().affectedKeys(): vale tanto para añadir, como para cambiar o borrar uno de esos campos.
//  4. Colecciones sin ninguna regla (solo servidor; la app no puede ni leerlas): iaUso, iaGlobal, iaCandado (cuotas diarias de IA),
//     refCodes, refCanjes (referidos), stravaTokens, stravaGlobal. Al no tener «match» caen en la denegación final.
//  5. Catálogo compartido: solo lectura con sesión (hoy el catálogo de ejercicios va dentro de la app y en Hosting, no en Firestore;
//     el bloque queda listo por si algún día se mueve aquí).
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Campos que solo cambia el servidor (ver punto 3).
    function serverFields() {
      return ['isPro', 'proPlan', 'proCaduca', 'proRenueva', 'proCancela', 'proActualizado',
              'stripeCustomerId', 'stripeSubscriptionId', 'strava', 'ultimoEscaneo',
              'refCode', 'referidos', 'recompensas', 'codigoUsado'];
    }

    // Pro vigente según el documento d: isPro y, si son días regalados por referidos (proCaduca, en ms), que no hayan caducado.
    function proVigente(d) {
      return d.get('isPro', false) == true
        && (d.get('proCaduca', null) == null || d.get('proCaduca', 0) <= 0 || d.get('proCaduca', 0) > request.time.toMillis());
    }

    // Catálogo compartido (ejercicios, GIFs…): lectura con sesión, escritura nunca desde la app.
    match /catalogo/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Sugerencias de funciones: cada persona envía las suyas (con su uid), pero nadie las lee desde la app (se ven en la consola de Firebase).
    match /feature_requests/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 1000;
    }

    // Feedback: mensaje libre (Perfil) y cuestionario opcional post-entreno de la beta. Solo crear con sesión y con tu propio uid;
    // nadie lo lee, cambia ni borra desde la app (se ve en la consola de Firebase). La fecha la pone siempre el servidor.
    //  (a) Mensaje libre (sin «tipo»): texto de 1 a 1000 caracteres y nota opcional de 1 a 5.
    //  (b) tipo = 'post_entreno': 5 respuestas sí/no (true, false o null si se dejan sin contestar) y explicaciones opcionales de hasta 200 caracteres.
    match /feedback/{id} {
      function respOk(r, k) { return r.get(k, null) == null || r.get(k, null) is bool; }
      function expOk(e, k) { return e.get(k, '') is string && e.get(k, '').size() <= 200; }
      function mensajeLibre(d) {
        return d.keys().hasOnly(['uid', 'email', 'mensaje', 'puntuacion', 'fecha'])
          && d.uid == request.auth.uid
          && d.mensaje is string && d.mensaje.size() >= 1 && d.mensaje.size() <= 1000
          && d.email is string && d.email.size() <= 254
          && (d.puntuacion == null || (d.puntuacion is int && d.puntuacion >= 1 && d.puntuacion <= 5))
          && d.fecha == request.time;
      }
      function postEntreno(d) {
        return d.keys().hasOnly(['tipo', 'uid', 'respuestas', 'explicaciones', 'fecha'])
          && d.keys().hasAll(['tipo', 'uid', 'respuestas', 'explicaciones', 'fecha'])
          && d.tipo == 'post_entreno'
          && d.uid == request.auth.uid
          && d.respuestas is map
          && d.respuestas.keys().hasOnly(['interfaz', 'comodidad', 'ia', 'registro', 'volver'])
          && respOk(d.respuestas, 'interfaz') && respOk(d.respuestas, 'comodidad') && respOk(d.respuestas, 'ia')
          && respOk(d.respuestas, 'registro') && respOk(d.respuestas, 'volver')
          && d.explicaciones is map
          && d.explicaciones.keys().hasOnly(['interfaz', 'comodidad', 'ia', 'registro', 'volver'])
          && expOk(d.explicaciones, 'interfaz') && expOk(d.explicaciones, 'comodidad') && expOk(d.explicaciones, 'ia')
          && expOk(d.explicaciones, 'registro') && expOk(d.explicaciones, 'volver')
          && d.fecha == request.time;
      }
      allow create: if signedIn() && (mensajeLibre(request.resource.data) || postEntreno(request.resource.data));
      allow read, update, delete: if false;
    }

    // Rutinas compartidas por código: el id del documento es el código. Con sesión se puede leer UNA si se sabe el código (get), no listarlas;
    // solo su autor la crea, la actualiza o la borra, y no puede cambiarle el autor.
    match /shared_routines/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && code.size() == 6;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);

      // Alta: perfil sin Pro, sin datos de pago ni de referidos (los pone el servidor) y dentro del límite gratuito (3 rutinas y 3 ejercicios propios).
      allow create: if isOwner(uid)
        && request.resource.data.get('isPro', false) == false
        && request.resource.data.get('proPlan', 'none') == 'none' // al crear, proPlan solo puede faltar o valer 'none'; los planes de pago los pone el servidor
        && request.resource.data.get('referidos', 0) == 0
        && request.resource.data.get('recompensas', []).size() == 0
        && !request.resource.data.keys().hasAny(['stripeCustomerId', 'stripeSubscriptionId', 'strava', 'ultimoEscaneo', 'refCode', 'codigoUsado',
                                                 'proCaduca', 'proRenueva', 'proCancela', 'proActualizado'])
        && request.resource.data.get('rutinas', []).size() <= 3
        && request.resource.data.get('ejPropios', []).size() <= 3;

      // Cambios: ningún campo solo-servidor puede cambiar.
      // Límite gratuito: sin Pro vigente, rutinas y ejercicios propios no pueden pasar de 3 (quien ya tenga más puede mantenerlos o borrar, no añadir).
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverFields())
        && (proVigente(resource.data)
          || ((request.resource.data.get('rutinas', []).size() <= 3 || request.resource.data.get('rutinas', []).size() <= resource.data.get('rutinas', []).size())
            && (request.resource.data.get('ejPropios', []).size() <= 3 || request.resource.data.get('ejPropios', []).size() <= resource.data.get('ejPropios', []).size())));

      // Datos personales: SOLO el dueño. Subcolecciones explícitas (cualquier subcolección nueva queda denegada hasta que se añada aquí).
      match /pesos/{id}    { allow read, write: if isOwner(uid); }  // peso y composición corporal
      match /entrenos/{id} { allow read, write: if isOwner(uid); }  // entrenos, historial y análisis del Coach AI
      match /comidas/{id}  { allow read, write: if isOwner(uid); }  // nutrición e hidratación (un documento por día)
      match /rutas/{id}    { allow read, write: if isOwner(uid); }  // rutas de bici
    }

    // Todo lo demás (iaUso, iaGlobal, iaCandado, refCodes, refCanjes, stravaTokens, stravaGlobal…): solo el servidor.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
